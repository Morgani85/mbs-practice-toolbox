# Practice Toolbox - Environment Variables Template

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database
PGHOST=your_postgresql_host
PGPORT=5432
PGUSER=your_database_user
PGPASSWORD=your_database_password
PGDATABASE=your_database_name

# Session Configuration
SESSION_SECRET=your_very_secure_random_session_secret_key_here

# Application Environment
NODE_ENV=development

# Optional: Email Service (for user invitations)
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Feature Flags (Client-side - must be prefixed with VITE_)
# Set to 'true' to enable Executive Overview module in production
VITE_ENABLE_OVERVIEW=false

# Development-only coaching seed script
COACH_TEST_EMAIL=
COACH_TEST_PASSWORD=
PORTAL_TEST_EMAIL=
PORTAL_TEST_PASSWORD=